# themodellab.pl - konfiguracja serwera
# Plik zarzadzany z repozytorium GitHub (damian-dealme/themodellab-site)

DirectoryIndex index.html

# Kopie index.html.1, index.html.2 ... (pozostalosc po pobieraniu przez wget)
# nie maja byc widoczne ani indeksowane - przekieruj na strone glowna.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html\.[0-9]+$ / [R=301,L]
</IfModule>

# Kompresja
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache dla statycznych zasobow
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
